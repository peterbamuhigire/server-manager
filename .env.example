# Application
APP_NAME="Chwezi Server Manager"
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=chwezi_sm
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=30
SESSION_SECURE=false
SESSION_NAME=chwezi_sm_session

# Security
CSRF_ENABLED=true

# Root User (initial setup)
ROOT_USERNAME=peter
ROOT_EMAIL=peter@techguypeter.com
ROOT_PASSWORD=

# Timezone
APP_TIMEZONE=Africa/Kampala

# Paths
APACHE_SITES_AVAILABLE=/etc/apache2/sites-available
APACHE_SITES_ENABLED=/etc/apache2/sites-enabled
WEB_ROOT=/var/www
CERTBOT_BIN=/usr/bin/certbot
